+        m.lx = (uint8_t)(int8_t)-7;
+        m.ly = 12;
+        m.buttons = (uint16_t)~SIO_MOUSE_BTN_LEFT;
+        psx_pad_apply_to_sio(0, &m);
+        psx_pad_apply_to_sio(0, &m);
+        (void)xchg(0x01); (void)xchg(0x42);
+        for (int i = 2; i < 7; i++) b[i] = xchg(0x00);
+        EXPECT("mouse.left", 0xF4, b[4]);
