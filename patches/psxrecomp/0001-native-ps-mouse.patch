diff --git a/runtime/src/ps_mouse_input.c b/runtime/src/ps_mouse_input.c
new file mode 100644
index 00000000..dc99c07b
--- /dev/null
+++ b/runtime/src/ps_mouse_input.c
@@ -0,0 +1,72 @@
+#include "ps_mouse_input.h"
+#include "sio.h"
+
+/* Bound on owed motion: 30 frames of full-speed travel, the same window the
+ * SIO device keeps (Mednafen mouse.cpp). Anything beyond is a stall, not aim. */
+#define PS_MOUSE_OWED_MAX (30.0f * 128.0f)
+
+static float s_dx, s_dy;
+static uint8_t s_held, s_pressed;
+static PsMouseFrame s_frame = { 0, 0, 0xFFFFu };
+
+static float owed_clamp(float v) {
+    if (v > PS_MOUSE_OWED_MAX) return PS_MOUSE_OWED_MAX;
+    if (v < -PS_MOUSE_OWED_MAX) return -PS_MOUSE_OWED_MAX;
+    return v;
+}
+
+/* Whole units toward zero, clipped to a signed byte; the remainder stays. */
+static int8_t take(float *owed) {
+    int v = (int)*owed;
+    if (v > 127) v = 127;
+    if (v < -128) v = -128;
+    *owed -= (float)v;
+    return (int8_t)v;
+}
+
+static uint16_t button_word(uint8_t pressed) {
+    uint16_t w = 0xFFFFu;
+    if (pressed & PS_MOUSE_LEFT) w &= (uint16_t)~SIO_MOUSE_BTN_LEFT;
+    if (pressed & PS_MOUSE_RIGHT) w &= (uint16_t)~SIO_MOUSE_BTN_RIGHT;
+    return w;
+}
+
+void ps_mouse_input_neutral(PsMouseFrame *out) {
+    if (!out) return;
+    out->dx = out->dy = 0;
+    out->buttons = 0xFFFFu;
+}
+
+void ps_mouse_input_reset(void) {
+    s_dx = s_dy = 0.0f;
+    s_held = s_pressed = 0;
+    ps_mouse_input_neutral(&s_frame);
+}
+
+void ps_mouse_input_motion(float dx, float dy) {
+    /* NaN fails both comparisons in owed_clamp; drop it here instead. */
+    if (dx != dx || dy != dy) return;
+    s_dx = owed_clamp(s_dx + dx);
+    s_dy = owed_clamp(s_dy + dy);
+}
+
+void ps_mouse_input_button(int button, int down) {
+    const uint8_t bit = (uint8_t)(button & (PS_MOUSE_LEFT | PS_MOUSE_RIGHT));
+    if (down) {
+        s_held |= bit;
+        s_pressed |= bit;
+    } else {
+        s_held &= (uint8_t)~bit;
+    }
+}
+
+void ps_mouse_input_latch(void) {
+    s_frame.dx = take(&s_dx);
+    s_frame.dy = take(&s_dy);
+    s_frame.buttons = button_word((uint8_t)(s_held | s_pressed));
+    s_pressed = 0;
+}
+
+void ps_mouse_input_frame(PsMouseFrame *out) {
+    if (out) *out = s_frame;
+}
diff --git a/runtime/src/ps_mouse_input.h b/runtime/src/ps_mouse_input.h
new file mode 100644
index 00000000..fbf2bd46
--- /dev/null
+++ b/runtime/src/ps_mouse_input.h
@@ -0,0 +1,39 @@
+#pragma once
+/* Host side of the emulated PlayStation Mouse (SIO_PAD_MOUSE): the PC mouse's
+ * relative motion and two buttons, collected from SDL events and handed to the
+ * guest once per sampled frame through PsxNetPad -> psx_pad_apply_to_sio.
+ *
+ * Motion is summed with its fractional part; each latch moves at most one
+ * signed byte per axis into the frame and keeps the rest for later frames, so
+ * a fast flick is spread over frames instead of being clipped away (the SIO
+ * device then spreads it over polls the same way). A button pressed and
+ * released between two latches still shows as pressed in the next frame.
+ *
+ * Pure: no SDL, no SIO. Owned by the SDL/main thread. */
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct PsMouseFrame {
+    int8_t   dx, dy;   /* +X right, +Y down, PlayStation Mouse units */
+    uint16_t buttons;  /* SIO_MOUSE_BTN_* active low, other bits set */
+} PsMouseFrame;
+
+enum { PS_MOUSE_LEFT = 0x01, PS_MOUSE_RIGHT = 0x02 };
+
+/* Forget owed motion, latched clicks and held buttons (capture release,
+ * reset, state load, device change). */
+void ps_mouse_input_reset(void);
+void ps_mouse_input_motion(float dx, float dy);
+void ps_mouse_input_button(int button, int down);
+/* Once per sampled frame: move this frame's share into the latched frame. */
+void ps_mouse_input_latch(void);
+/* The latched frame; reading does not consume it. */
+void ps_mouse_input_frame(PsMouseFrame *out);
+/* Neutral frame (no motion, no buttons). */
+void ps_mouse_input_neutral(PsMouseFrame *out);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/runtime/src/ps_mouse_sdl.cpp b/runtime/src/ps_mouse_sdl.cpp
new file mode 100644
index 00000000..7449602c
--- /dev/null
+++ b/runtime/src/ps_mouse_sdl.cpp
@@ -0,0 +1,140 @@
+#include "ps_mouse_sdl.h"
+#include "ps_mouse_input.h"
+#include "host_osd.h"
+
+namespace {
+SDL_Window* window_ = nullptr;
+bool enabled_ = false;
+bool live_ = false;
+bool captured_ = false;
+bool hinted_ = false;
+
+bool set_relative(bool on) {
+    if (!window_) return !on;
+#if defined(PSX_SDL3)
+    return SDL_SetWindowRelativeMouseMode(window_, on);
+#else
+    return SDL_SetRelativeMouseMode(on ? SDL_TRUE : SDL_FALSE) == 0;
+#endif
+}
+
+bool focused() {
+    if (!window_ || SDL_GetKeyboardFocus() != window_) return false;
+    const auto flags = SDL_GetWindowFlags(window_);
+    return (flags & (SDL_WINDOW_HIDDEN | SDL_WINDOW_MINIMIZED)) == 0;
+}
+
+bool our_window(Uint32 window_id) {
+    return window_ && window_id == SDL_GetWindowID(window_);
+}
+
+void acquire() {
+    if (!set_relative(true)) {
+        host_osd_push("PlayStation Mouse: the mouse could not be captured", 2000);
+        return;
+    }
+    captured_ = true;
+    ps_mouse_input_reset();
+    host_osd_push("PlayStation Mouse captured (Esc releases)", 1500);
+}
+
+int ps_button(Uint8 sdl_button) {
+    if (sdl_button == SDL_BUTTON_LEFT) return PS_MOUSE_LEFT;
+    if (sdl_button == SDL_BUTTON_RIGHT) return PS_MOUSE_RIGHT;
+    return 0;
+}
+} // namespace
+
+void psx_ps_mouse_release() {
+    if (captured_) set_relative(false);
+    captured_ = false;
+    ps_mouse_input_reset();
+}
+
+void psx_ps_mouse_set_enabled(bool enabled) {
+    if (!enabled) psx_ps_mouse_release();
+    enabled_ = enabled;
+    if (!enabled) hinted_ = false;
+}
+
+bool psx_ps_mouse_enabled() { return enabled_; }
+bool psx_ps_mouse_captured() { return captured_; }
+
+void psx_ps_mouse_begin(SDL_Window* window, bool live) {
+    if (!enabled_) return;
+    if (window_ && window_ != window) psx_ps_mouse_release();
+    window_ = window;
+    live_ = live;
+    if (captured_ && (!live_ || !focused())) psx_ps_mouse_release();
+    if (live_ && !hinted_ && window_) {
+        hinted_ = true;
+        host_osd_push("PlayStation Mouse: click in the window to capture", 3000);
+    }
+}
+
+bool psx_ps_mouse_event(const SDL_Event& ev) {
+    if (!enabled_) return false;
+#if defined(PSX_SDL3)
+    if (ev.type == SDL_EVENT_WINDOW_FOCUS_LOST || ev.type == SDL_EVENT_WINDOW_HIDDEN ||
+        ev.type == SDL_EVENT_WINDOW_MINIMIZED) {
+        if (our_window(ev.window.windowID)) psx_ps_mouse_release();
+        return false;
+    }
+    if (ev.type == SDL_EVENT_MOUSE_REMOVED) {
+        psx_ps_mouse_release();
+        return false;
+    }
+#else
+    if (ev.type == SDL_WINDOWEVENT && our_window(ev.window.windowID) &&
+        (ev.window.event == SDL_WINDOWEVENT_FOCUS_LOST ||
+         ev.window.event == SDL_WINDOWEVENT_HIDDEN ||
+         ev.window.event == SDL_WINDOWEVENT_MINIMIZED)) {
+        psx_ps_mouse_release();
+        return false;
+    }
+#endif
+    if (ev.type == SDL_MOUSEMOTION) {
+        if (!captured_ || ev.motion.which == SDL_TOUCH_MOUSEID) return false;
+#if defined(PSX_SDL3)
+        if (ev.motion.which == SDL_PEN_MOUSEID) return false;
+#endif
+        ps_mouse_input_motion((float)ev.motion.xrel, (float)ev.motion.yrel);
+        return true;
+    }
+    if (ev.type == SDL_MOUSEBUTTONDOWN || ev.type == SDL_MOUSEBUTTONUP) {
+        if (ev.button.which == SDL_TOUCH_MOUSEID) return false;
+#if defined(PSX_SDL3)
+        if (ev.button.which == SDL_PEN_MOUSEID) return false;
+#endif
+        const bool down = ev.type == SDL_MOUSEBUTTONDOWN;
+        if (!captured_) {
+            // Only a fresh left click in the focused game window, on a live
+            // frame, acquires. The acquiring click is not a guest click.
+            if (down && live_ && ev.button.button == SDL_BUTTON_LEFT &&
+                our_window(ev.button.windowID) && focused()) {
+                acquire();
+                return captured_;
+            }
+            return false;
+        }
+        // The release of a button pressed before capture reports "up" for a
+        // button the guest never saw down; that is harmless.
+        if (const int b = ps_button(ev.button.button)) ps_mouse_input_button(b, down);
+        return true;
+    }
+    if (captured_ && (ev.type == SDL_KEYDOWN || ev.type == SDL_KEYUP)) {
+#if defined(PSX_SDL3)
+        const auto sc = ev.key.scancode;
+#else
+        const auto sc = ev.key.keysym.scancode;
+#endif
+        if (sc == SDL_SCANCODE_ESCAPE) {
+            if (ev.type == SDL_KEYDOWN && !ev.key.repeat) {
+                psx_ps_mouse_release();
+                host_osd_push("PlayStation Mouse released", 1200);
+            }
+            return true;
+        }
+    }
+    return false;
+}
